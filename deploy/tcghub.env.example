# /etc/tcghub/tcghub.env  (root:tcghub, chmod 640). Nunca commite o arquivo preenchido.
APP_ENV=production
# Domínios que o app aceita no cabeçalho Host (separados por vírgula).
APP_HOSTS=seudominio.com.br,www.seudominio.com.br
SESSION_COOKIE_SECURE=1
# Precisa ficar vazio em produção: o app se recusa a subir se estiver preenchido.
DEV_AUTH_USER_ID=

# Firebase Admin (servidor): chave da conta de serviço copiada para o servidor.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/etc/tcghub/service-account.json

# Firebase Web (navegador): Console do Firebase > Configurações do projeto > Seus apps > Web.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# Gemini (scan por foto).
GEMINI_API_KEY=
# Scans por pessoa por hora (cada worker conta separado).
SCAN_LIMIT_PER_HOUR=40